{
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.ts", "related": true },
  "mutate": ["src/exportScope.ts"],
  "coverageAnalysis": "perTest",
  "concurrency": 4,
  "timeoutMS": 60000,
  "reporters": ["json", "clear-text"],
  "jsonReporter": { "fileName": "/tmp/tga-stryker-export-scope/mutation.json" },
  "tempDirName": "/tmp/tga-stryker-export-scope/tmp",
  "inPlace": true,
  "checkers": [],
  "ignoreStatic": true
}